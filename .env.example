# Configure this key securely via the Secrets panel in the AI Studio UI.
FASTROUTER_API_KEY=YOUR_FASTROUTER_API_KEY

# DEEPSEEK_API_KEY: Optional direct API key if using DeepSeek endpoint directly.
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
